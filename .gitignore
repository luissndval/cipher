# cipher — .gitignore

# API keys y paths locales — NUNCA al repo
.cipher/config.local.json

# Artefactos generados por install.py — paths absolutos del developer
bin/cipheria
bin/cipheria.cmd
bin/cipher

# Datos generados en runtime — no son del repo
.cipher/sessions/
.cipher/tasks/
.cipher/packs/
.cipher/alerts/
.cipher/audit/
.cipher/index/

# Contexto generado automáticamente
CLAUDE.md
.cipher/ACTIVE_CONTEXT.md
.cipher/task-agent.md
.cipher/ALERT.md

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Node
node_modules/
npm-debug.log

# OS
.DS_Store
Thumbs.db
*.log

# Editores
.vscode/
.idea/
*.swp
*.swo
